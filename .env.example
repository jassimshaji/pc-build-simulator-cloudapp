# Copy to .env.local (Next.js) and fill in real values. Never commit the real file.

# --- Database (Neon Postgres in production, local Postgres via docker/ for dev) ---
DATABASE_URL="postgresql://user:password@localhost:5432/pcbuilder?schema=public"

# --- Auth.js (next-auth v4 reads these specific names) ---
NEXTAUTH_SECRET="generate-with: node -e \"console.log(require('crypto').randomBytes(32).toString('base64'))\""
NEXTAUTH_URL="http://localhost:3000"

# --- S3-compatible object storage ---
# Local dev: self-hosted SeaweedFS (see docs/DEVELOPMENT.md — MinIO's
# community server was discontinued, SeaweedFS is the open-source
# replacement). Production: Cloudflare R2. Same S3 API, same env var names —
# only the values change between environments.
S3_ENDPOINT="http://127.0.0.1:8333"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET_NAME="pc-builder-assets"
S3_PUBLIC_URL="http://127.0.0.1:8333/pc-builder-assets"
S3_FORCE_PATH_STYLE="true"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
