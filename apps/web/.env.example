# Copy to .env.local and fill in real values. Never commit the real file.

DATABASE_URL="postgresql://pcbuilder:pcbuilder@localhost:5432/pcbuilder?schema=public"

# next-auth v4 reads NEXTAUTH_SECRET/NEXTAUTH_URL specifically. Generate a secret
# with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET="generate-a-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# S3-compatible object storage. Locally: a self-hosted SeaweedFS S3 gateway
# (see docs/DEVELOPMENT.md for setup — MinIO's community server was
# discontinued, SeaweedFS is the open-source replacement used here).
# In production: Cloudflare R2 — same env vars, different values.
S3_ENDPOINT="http://127.0.0.1:8333"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="pcbuilder"
S3_SECRET_ACCESS_KEY="pcbuilderlocaldev"
S3_BUCKET_NAME="pc-builder-assets"
S3_PUBLIC_URL="http://127.0.0.1:8333/pc-builder-assets"
S3_FORCE_PATH_STYLE="true"
